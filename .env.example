# Copy this file to .env.local and fill in real values.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/interrogation_room

# Gemini API key from https://aistudio.google.com (server-only).
GEMINI_API_KEY=your_gemini_api_key
# Optional second key, used automatically when the first one's quota runs out.
# Only helps if it belongs to a DIFFERENT Google Cloud project (quotas are per project).
GEMINI_API_KEY_BACKUP=

# Admin accounts live in the database. Create one with:
#   npm run admin:create -- <username>

# How many cases players may create with AI (rolling 24 hours). 0 switches it off.
PLAYER_DAILY_CASE_LIMIT=3
SITE_DAILY_CASE_LIMIT=30
# How many questions each player may ask suspects (rolling 24 hours).
PLAYER_DAILY_QUESTION_LIMIT=200

# "Continue with Google" login. Leave both empty to hide the button.
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
#    -> OAuth client ID -> type "Web application".
# 2. Under "Authorized redirect URIs" add (exactly, including http/https and port):
#      http://localhost:3000/auth/google/callback
#    and, once deployed, https://YOUR-DOMAIN/auth/google/callback
# 3. If asked to set up a consent screen: user type External, and the scopes
#    "openid" and "email" are enough.
# Server-only: never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
