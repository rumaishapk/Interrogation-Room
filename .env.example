# Copy this file to .env.local and fill in real values.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/interrogation_room

# Gemini API key from https://aistudio.google.com (server-only).
GEMINI_API_KEY=your_gemini_api_key

# Admin login for /admin. Use a long password.
ADMIN_PASSWORD=choose_a_long_admin_password
# Random secret used to sign the login cookie, at least 32 characters.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace_with_output_of_openssl_rand_hex_32

# How many cases players may create with AI (rolling 24 hours). 0 switches it off.
PLAYER_DAILY_CASE_LIMIT=3
SITE_DAILY_CASE_LIMIT=30
